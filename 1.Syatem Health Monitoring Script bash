#!/bin/bash
# Set thresholds
CPU_THRESHOLD=80
MEMORY_THRESHOLD=80
DISK_THRESHOLD=80

#Function to check CPU usage check_cpu()
{
    CPU_USAGE=$(top-bn1| grep"Cpu(s)"|sed"s/.,*\([0-9]\)%*id.*/\1/"|awk'{print 100 -$1}')
    if ((($echo"$CPU_USAGE>$CPU_THRESHOLD"|bc -l)));
    then
    echo"$(date)-ALERT:Memory usage is at ${MEMORY_USAGE}%(Threshold:${MEMORY_THRESHOLD}%)">>/var/log/system_health.log fi
}
#Function to check memory usage check_memory()
{
    MEMORY_USAGE=$(free|grep Mem|awk'{print $3/$2*100.0}')
    if (($(echo"$MEMORY_USAGE>$MEMORY_THRESHOLD"|bc -l)));
    then
    echo"$(date) -ALERT:Memory usage is at ${MEMORY_USAGE}%(Threshold:${Memory_THRESHOLD}%)">>/var/log/system_health.log fi
}
 #Funton to check disk space usage check_disk()
 {
    DISK_USAGE=$(df /| grep/| awk'{print $5}'|sed's/%//g')
    if ["$DISK_USAGE"-gt"$DISK_THRESHOLD"];
    then
    echo"$(date)-ALERT:Disk usage is at ${DISK_USAGE}%(Threshold:${DISK_THRESHOLD}%)">>/var/log/system_health.log fi
 }
 #Function to check running processes check_processes()
 {
    RUNNING_PROCESSES=$(ps aux--sort=-%cpu|head -n 5)
    echo"$(date) - Top5 processes by CPU usage:">>/var/log/system_health.log
    echo"$RUNNING_PROCESSES">>/var/log/system_health.log
 }
